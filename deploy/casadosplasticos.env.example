# ─── ShopPro — Casa dos Plásticos & Brinquedos Shopping (E. F. PYL LTDA) ─────
# Variáveis do serviço Railway da 2ª loja (serviço + Postgres próprios).
# Formato do "Raw Editor" do Railway: CHAVE=valor, um por linha, sem aspas
# (o JSON dos endereços vai cru mesmo). Lista completa: deploy/README-marca.md.
#
# Linhas com TODO ainda não têm o dado certo — preencher antes de publicar.
# Elas ficam de propósito com um valor que aparece no site ("TODO ..."), pra
# ninguém esquecer: se apagar a linha, volta o padrão, que é o da LUQUI.

# ── Site / infraestrutura (variáveis que já existiam) ──
SITE_URL=https://www.casadosplasticosshopping.com.br
CLUBE_LUQUI_ATIVO=0
# TODO: chave da integração do PDV Pro da EF Pyl
PDVPRO_API_KEY=TODO
# TODO: número do WhatsApp da loja em E.164 sem "+" (ex.: 5545999999999).
# Sem estas duas, o padrão vem de MARCA_TELEFONE_E164.
# WHATSAPP_LOJA=
# ADMIN_WHATSAPP=
# Remetente dos e-mails: domínio precisa estar verificado no Resend.
# EMAIL_FROM=Casa dos Plásticos <contato@luqsys.com.br>
# EMAIL_REPLY_TO=TODO

# ── Identidade ──
MARCA_NOME=Casa dos Plásticos & Brinquedos Shopping
MARCA_NOME_CURTO=Casa dos Plásticos
MARCA_RAZAO_SOCIAL=E. F. PYL LTDA
MARCA_CNPJ=37.616.291/0001-57
# TODO: slogan e frase do rodapé são sugestão — confirmar com a loja
MARCA_SLOGAN=Tudo pra sua casa num lugar só
MARCA_FRASE_RODAPE=Utilidades, plásticos e brinquedos em Cascavel.
MARCA_SEGMENTO=utilidades
MARCA_TIPO_LOJA=loja de utilidades e brinquedos
MARCA_ITEM=produto
MARCA_ITENS=produtos
MARCA_META_DESCRICAO=Casa dos Plásticos & Brinquedos Shopping — utilidades domésticas, plásticos e brinquedos. Loja física em Cascavel/PR.
MARCA_OG_DESCRICAO=Utilidades domésticas, plásticos e brinquedos. Cascavel/PR — envio pra todo Brasil.
MARCA_SCHEMA_TIPO=HomeGoodsStore
MARCA_EMOJI=🛒
# Fatura do cartão (Pagar.me): até 13 caracteres, sem acento
MARCA_DESCRITOR_FATURA=CASAPLASTICOS
# A faixa "online você paga 15% menos que na loja física" é política da
# Luqui. 0 = some. TODO: confirmar se a Casa dos Plásticos tem desconto online.
MARCA_DESCONTO_ONLINE_PCT=0

# ── Contato ──
# TODO: telefone/WhatsApp da loja
MARCA_TELEFONE_EXIBICAO=TODO (45) 9xxxx-xxxx
MARCA_TELEFONE_E164=+55TODO
# TODO: e-mail de contato da loja
MARCA_EMAIL=TODO@casadosplasticosshopping.com.br
MARCA_INSTAGRAM=casadosplasticosshopping
# TODO: Facebook — "-" = sem Facebook (some do rodapé e do JSON-LD)
MARCA_FACEBOOK=-

# ── Endereços (o 1º é a loja principal: JSON-LD, CEP de origem, texto do frete) ──
MARCA_ENDERECOS=[{"nome":"Casa dos Plásticos","logradouro":"R. Souza Naves","numero":"3768","bairro":"Centro","cidade":"Cascavel","uf":"PR","cep":"","obs":"Estacionamento pela R. Rio Grande do Sul, 744"},{"nome":"Luqui Brinquedos","logradouro":"R. Engenheiro Rebouças","numero":"2053","bairro":"Centro","cidade":"Cascavel","uf":"PR","cep":"85812-130","obs":""}]
# TODO: CEP da R. Souza Naves, 3768 — vai no 1º endereço acima e aqui
# (origem do Melhor Envio). Sem ele, a origem cai no CEP da Luqui.
# MARCA_CEP_ORIGEM=
# TODO: confirmar o horário. Linhas pro texto; o JSON-LD usa MARCA_HORARIO_SCHEMA.
MARCA_HORARIO=["Seg a sex: 08:00 às 18:00","Sábado: 08:00 às 12:00","Domingo: fechado"]
MARCA_HORARIO_SCHEMA=[{"dias":["Monday","Tuesday","Wednesday","Thursday","Friday"],"abre":"08:00","fecha":"18:00"},{"dias":"Saturday","abre":"08:00","fecha":"12:00"}]

# ── Visual (logo oval verde + laranja) ──
MARCA_LOGO=/static/marcas/casa-dos-plasticos.png
MARCA_FAVICON=/static/marcas/casa-dos-plasticos-favicon.png
MARCA_APPLE_TOUCH_ICON=/static/marcas/casa-dos-plasticos-apple-touch-icon.png
